        "custom_liquid": "<style>.asg-wrap{--red:#D2232A;--dred:#9E1B1B;--green:#111111;--gold:#FFC72C;--cream:#FFF3D9;--brown:#A9714B;--ink:#1A1A1A;font-family:Nunito,system-ui,sans-serif;display:flex;justify-content:center;padding:10px 14px}.asg{position:relative;width:100%;max-width:560px;background:linear-gradient(180deg,#ffffff,#f1f7ff);border:2px solid #eef2f7;border-radius:22px;padding:26px 22px 28px;text-align:center;box-shadow:0 16px 40px rgba(20,25,40,.10);overflow:hidden}.asg .kick{font-weight:800;letter-spacing:.2em;font-size:11px;color:var(--green);margin-bottom:6px}.asg .globe{width:186px;height:206px;margin:2px auto 4px;position:relative;animation:asgBob 3.6s ease-in-out infinite}.asg .dome{position:absolute;top:0;left:50%;transform:translateX(-50%);width:150px;height:150px;border-radius:50%;overflow:hidden;background:radial-gradient(circle at 34% 26%,rgba(255,255,255,.6),rgba(210,235,255,.2) 42%,rgba(120,170,210,.12));box-shadow:inset 0 0 32px rgba(255,255,255,.55),0 8px 18px rgba(0,0,0,.14);border:3px solid rgba(255,255,255,.75)}.asg .dome img{position:absolute;top:40px;left:50%;transform:translateX(-50%);width:82px;height:82px;filter:drop-shadow(0 3px 5px rgba(0,0,0,.2))}.asg .gsnow{position:absolute;inset:0;pointer-events:none}.asg .gsnow i{position:absolute;top:-8px;color:#fff;opacity:.9;animation:asgFall linear infinite}.asg .base{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:172px;height:56px;background:linear-gradient(180deg,#bd884f,#8a5e34);border-radius:12px 12px 14px 14px;box-shadow:inset 0 4px 8px rgba(255,255,255,.22),0 6px 14px rgba(0,0,0,.16)}.asg .plaque{position:absolute;top:13px;left:50%;transform:translateX(-50%);background:var(--gold);color:#5a3d00;font-family:\"Fredoka\",Nunito,sans-serif;font-weight:800;font-size:13px;letter-spacing:.05em;padding:6px 14px;border-radius:7px;white-space:nowrap;box-shadow:0 2px 0 #d09a00}.asg h3{font-family:\"Fredoka\",\"Fredoka\",cursive;color:var(--red);font-size:34px;line-height:.95;letter-spacing:.5px;text-shadow:0 3px 0 var(--dred);margin:12px 0 0}.asg h3 span{display:block;font-family:\"Fredoka\",Nunito,sans-serif;color:var(--ink);font-size:16px;letter-spacing:0;text-shadow:none;margin-top:5px}.asg p{color:#3c4550;font-size:14.5px;font-weight:600;max-width:400px;margin:12px auto 18px}.asg .cta{position:relative;display:inline-block;overflow:hidden;text-decoration:none;font-family:\"Fredoka\",Nunito,sans-serif;font-weight:800;color:#fff;background:var(--red);border-radius:999px;padding:15px 32px;font-size:18px;box-shadow:0 6px 0 var(--dred),0 12px 20px rgba(0,0,0,.18)}.asg .cta .sw{position:absolute;top:0;bottom:0;left:-60%;width:45%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);transform:skewX(-18deg);animation:asgShine 3.2s ease-in-out infinite}@keyframes asgBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}@keyframes asgFall{0%{transform:translateY(-8px);opacity:0}12%{opacity:.95}100%{transform:translateY(150px) translateX(12px);opacity:.1}}@keyframes asgShine{0%{left:-60%}60%,100%{left:130%}}@media(prefers-reduced-motion:reduce){.asg .globe,.asg .gsnow i,.asg .cta .sw{animation:none}}@media(max-width:600px){.asg h3{font-size:28px}.asg .globe{width:170px}}</style><div class=\"asg-wrap\"><div class=\"asg\"><div class=\"kick\">SHAKE FOR CHRISTMAS SAVINGS</div><div class=\"globe\"><div class=\"dome\"><img src=\"{{ 'mickey-snugs-logo.png' | asset_url }}\" alt=\"Mickey Snugs\"><div class=\"gsnow\"><i style=\"left:33.8%;font-size:5.8px;animation-duration:5.3s;animation-delay:-0.4s\">❄</i><i style=\"left:53.3%;font-size:6.8px;animation-duration:3.4s;animation-delay:-1.7s\">❅</i><i style=\"left:7.4%;font-size:7.2px;animation-duration:3.4s;animation-delay:-0.3s\">•</i><i style=\"left:43.1%;font-size:9.1px;animation-duration:3.6s;animation-delay:-0.8s\">❄</i><i style=\"left:61.7%;font-size:9.7px;animation-duration:5.1s;animation-delay:-2.0s\">❅</i><i style=\"left:93.8%;font-size:5.2px;animation-duration:6.0s;animation-delay:-1.7s\">•</i><i style=\"left:17.3%;font-size:5.6px;animation-duration:4.2s;animation-delay:-3.4s\">❄</i><i style=\"left:20.6%;font-size:7.9px;animation-duration:5.3s;animation-delay:-2.0s\">❅</i><i style=\"left:54.4%;font-size:5.3px;animation-duration:3.4s;animation-delay:-0.7s\">•</i><i style=\"left:66.6%;font-size:7.1px;animation-duration:4.2s;animation-delay:-2.5s\">❄</i><i style=\"left:45.7%;font-size:6.5px;animation-duration:5.8s;animation-delay:-4.1s\">❅</i><i style=\"left:26.5%;font-size:7.9px;animation-duration:4.9s;animation-delay:-4.3s\">•</i><i style=\"left:71.1%;font-size:6.4px;animation-duration:6.4s;animation-delay:-0.8s\">❄</i><i style=\"left:42.5%;font-size:8.8px;animation-duration:3.7s;animation-delay:-1.8s\">❅</i><i style=\"left:7.6%;font-size:8.3px;animation-duration:5.7s;animation-delay:-3.3s\">•</i><i style=\"left:84.5%;font-size:6.6px;animation-duration:5.5s;animation-delay:-3.3s\">❄</i></div></div><div class=\"base\"><div class=\"plaque\">50% OFF PRE-ORDER</div></div></div><h3>The Coziest Gift<span>under the tree this year</span></h3><p>Reserve your Mickey Snugs hood for 50% off. Only a limited Christmas batch, and the price jumps back up the moment it sells out.</p><a class=\"cta\" href=\"#top\" onclick=\"window.scrollTo({top:0,behavior:'smooth'});return false;\">Reserve My Robe ❄️<span class=\"sw\"></span></a></div></div>",
